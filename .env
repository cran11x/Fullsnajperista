# Pump.Fun Sniper Bot - Environment Variables

# ==================== WALLET ====================
# Tvoj Solana wallet private key (kao JSON array)
# Dobij sa: solana-keygen export wallet.json
SOLANA_PRIVATE_KEY=44opMbqQkoH81qYgSTJjNqzuEoe5hFsZPfMcWz892EkVh263UU1qkJhjxKRQo7U11ZQkLLKnT3i8APjaMFpsSJeW

# ILI path do wallet fajla
WALLET_PATH=./wallet.json

# ==================== RPC ENDPOINTS ====================
# Solana RPC URL (obavezno brz endpoint za sniping!)
RPC_URL=

# WebSocket URL
WSS_URL=

# Helius (preporučeno - besplatan key: https://helius.dev)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# QuickNode (plaćeno ali vrlo brzo: https://quicknode.com)
# RPC_URL=https://YOUR_ENDPOINT.quiknode.pro/YOUR_KEY/

# ==================== JITO ====================
# Enable Jito bundles (true/false)
USE_JITO=true

# Jito tip amount in lamports
JITO_TIP_LAMPORTS=50000

# Jito block engine URL
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# ==================== TRADING CONFIG ====================
# Amount to spend per buy (in SOL)
BUY_AMOUNT_SOL=0.05

# Priority fee (micro-lamports per compute unit)
# Low: 10000, Medium: 100000, High: 500000, Turbo: 1000000
PRIORITY_FEE=200000

# Compute unit limit
COMPUTE_UNITS=300000

# Slippage tolerance in basis points (100 = 1%)
SLIPPAGE_BPS=500

# ==================== BOT BEHAVIOR ====================
# Auto-buy on detection (true/false)
AUTO_BUY=true

# Minimum liquidity in SOL to consider buying
MIN_LIQUIDITY_SOL=0.5

# Maximum buy amount in SOL
MAX_BUY_AMOUNT_SOL=1.0

# Delay before buying (milliseconds) - za testiranje
BUY_DELAY_MS=0

# ==================== LOGGING ====================
# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Log to file
LOG_TO_FILE=false
LOG_FILE_PATH=./bot.log

# ==================== MONITORING ====================
# Discord webhook za notifications (opciono)
DISCORD_WEBHOOK_URL=

# Telegram bot token (opciono)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== SAFETY ====================
# Max total spent per day in SOL
MAX_DAILY_SPEND_SOL=10.0

# Max number of buys per day
MAX_DAILY_BUYS=100

# Blacklist specific creators (comma separated pubkeys)
BLACKLIST_CREATORS=

# Whitelist specific creators (comma separated pubkeys)
WHITELIST_CREATORS=

# ==================== ADVANCED ====================
# Use existing buy TX method instead of init TX
USE_EXISTING_BUY_METHOD=false

# Retry attempts for failed transactions
TX_RETRY_ATTEMPTS=3

# Retry delay in milliseconds
TX_RETRY_DELAY_MS=500
